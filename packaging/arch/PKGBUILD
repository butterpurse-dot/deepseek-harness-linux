# Maintainer: Infinite Foundation <butterpurse@gmail.com>
# Build with: makepkg -si
# Update: bump pkgver/_version, run `updpkgsums`, then `makepkg -si`.
pkgname=deepseek-harness-bin
pkgver=0.2.2alpha2
pkgrel=1
_version=0.2.2-alpha.2
_tag=v${_version}
pkgdesc="DeepSeek Harness desktop app packaged as an AppImage"
arch=('x86_64' 'aarch64')
url="https://github.com/butterpurse-dot/deepseek-harness-linux"
license=('MIT')
depends=('fuse2' 'alsa-lib' 'gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux' 'libsecret' 'mesa' 'libappindicator')
provides=('deepseek-harness')
conflicts=('deepseek-harness')
options=(!strip)

source=("deepseek-harness.png::https://raw.githubusercontent.com/butterpurse-dot/deepseek-harness-linux/master/apps/desktop/resources/icon.png")
source_x86_64=("deepseek-harness-${_version}-linux-x86_64-unsigned.AppImage::https://github.com/butterpurse-dot/deepseek-harness-linux/releases/download/${_tag}/deepseek-harness-${_version}-linux-x86_64-unsigned.AppImage")
source_aarch64=("deepseek-harness-${_version}-linux-arm64-unsigned.AppImage::https://github.com/butterpurse-dot/deepseek-harness-linux/releases/download/${_tag}/deepseek-harness-${_version}-linux-arm64-unsigned.AppImage")
sha256sums=('982c2859568d83d2576110a527c545f04641f4008bdb2cfeb6758f333c0fb07a')
sha256sums_x86_64=('470bbfbbc247c36b8d64a6bef5360e636c05dad074567aeb3560f6e1c58a7292')
sha256sums_aarch64=('99214b9a6b2ecbfc72c79348421aa683de8a452a6987e02a021ea50a26b511f5')

package() {
  local appimage
  case "$CARCH" in
    x86_64) appimage="deepseek-harness-${_version}-linux-x86_64-unsigned.AppImage" ;;
    aarch64) appimage="deepseek-harness-${_version}-linux-arm64-unsigned.AppImage" ;;
    *) error "unsupported architecture: $CARCH" ;;
  esac

  install -Dm755 "$srcdir/$appimage" "$pkgdir/opt/deepseek-harness/deepseek-harness.AppImage"
  install -d "$pkgdir/usr/bin"
  ln -s /opt/deepseek-harness/deepseek-harness.AppImage "$pkgdir/usr/bin/deepseek-harness"
  install -Dm644 "$srcdir/deepseek-harness.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/deepseek-harness.png"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/deepseek-harness.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=DeepSeek Harness
Comment=DeepSeek Harness desktop client
Exec=/opt/deepseek-harness/deepseek-harness.AppImage %U
Icon=deepseek-harness
Terminal=false
Categories=Development;
StartupNotify=true
StartupWMClass=dsh-desktop
MimeType=x-scheme-handler/dsh;
EOF
  chmod 644 "$pkgdir/usr/share/applications/deepseek-harness.desktop"
}
